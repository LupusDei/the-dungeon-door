# Ships The Dungeon Door to TestFlight. Run through ../ship.sh, which builds a clean copy of HEAD.
# Adapted from the owner's Herborica pipeline: same team, App Store Connect API key and match repo.

default_platform(:ios)

APP_IDENTIFIER = "com.jmm.the-dungeon-door"
TEAM = ENV["TEAM_ID"] || "2BRYAM5Q52"
PROJECT = "DungeonDoor.xcodeproj"
SCHEME = "DungeonDoor"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Sync certificates and provisioning profiles"
  lane :sync_certs do
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: is_ci)
  end

  desc "Set the build number to one past the newest on TestFlight"
  lane :bump_build do
    increment_build_number(
      build_number: latest_testflight_build_number(
        api_key: connect_api_key,
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      ) + 1,
      xcodeproj: PROJECT
    )
  end

  desc "Build the app for TestFlight"
  lane :build_beta do
    sync_certs
    bump_build

    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: TEAM,
      profile_name: "match AppStore #{APP_IDENTIFIER}",
      code_sign_identity: "iPhone Distribution",
      targets: ["DungeonDoor"]
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}" }
      },
      output_directory: "./build",
      output_name: "DungeonDoor.ipa"
    )
  end

  desc "Upload to TestFlight for internal testing"
  lane :beta do
    build_beta
    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "New build"
    )
  end

  def connect_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "./fastlane/AuthKey.p8"
    )
  end

  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")
  end
end
