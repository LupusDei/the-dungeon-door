{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/characters/revive",
      "destination": "/api/character-revive"
    },
    {
      "source": "/api/characters/retire",
      "destination": "/api/character-retire"
    },
    {
      "source": "/api/characters/unretire",
      "destination": "/api/character-unretire"
    },
    {
      "source": "/api/characters/ability-boost",
      "destination": "/api/character-ability-boost"
    },
    {
      "source": "/api/games/:code/join",
      "destination": "/api/game-join?code=:code"
    },
    {
      "source": "/api/games/:code/leave",
      "destination": "/api/game-leave?code=:code"
    },
    {
      "source": "/api/games/:code/messages",
      "destination": "/api/game-messages?code=:code"
    },
    {
      "source": "/api/games/:code/reactions",
      "destination": "/api/game-reactions?code=:code"
    },
    {
      "source": "/api/games/:code/typing",
      "destination": "/api/game-typing?code=:code"
    },
    {
      "source": "/api/games/:code/speak",
      "destination": "/api/game-speak?code=:code"
    },
    {
      "source": "/api/games/:code/dungeon-master",
      "destination": "/api/game-dungeon-master?code=:code"
    },
    {
      "source": "/api/games/:code/start",
      "destination": "/api/game-start?code=:code"
    },
    {
      "source": "/api/games/:code/vote",
      "destination": "/api/game-vote?code=:code"
    },
    {
      "source": "/api/games/:code/roll",
      "destination": "/api/game-roll?code=:code"
    },
    {
      "source": "/api/games/:code/action",
      "destination": "/api/game-action?code=:code"
    },
    {
      "source": "/api/games/:code/advance",
      "destination": "/api/game-advance?code=:code"
    },
    {
      "source": "/api/games/:code/ending",
      "destination": "/api/game-ending?code=:code"
    },
    {
      "source": "/api/games/:code/invites",
      "destination": "/api/game-invites?code=:code"
    },
    {
      "source": "/api/games/:code/narration",
      "destination": "/api/game-narration?code=:code"
    },
    {
      "source": "/api/games/:code",
      "destination": "/api/game?code=:code"
    }
  ]
}
