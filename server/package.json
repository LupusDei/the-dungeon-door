{
  "name": "the-dungeon-door-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DD_FAKE_AI=${DD_FAKE_AI:-1} node --experimental-strip-types scripts/dev.ts",
    "dev:real": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"lib/**/*.test.ts\"",
    "migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "seed:quests": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-quests.ts",
    "mcp:smoke": "node --experimental-strip-types scripts/mcp-smoke.ts",
    "bot": "node --experimental-strip-types scripts/bot.ts",
    "coverage": "mkdir -p coverage && node --test --experimental-strip-types --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"lib/**/*.test.ts\"",
    "playtest": "node --experimental-strip-types scripts/playtest.ts",
    "fights": "node --experimental-strip-types scripts/fights.ts",
    "dm:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/dm-check.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.4",
    "ai": "^7.0.181",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
