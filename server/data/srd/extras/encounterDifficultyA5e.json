      "index": "a5e-combat-encounter-difficulty",
      "name": "A5E Combat Encounter Difficulty",
      "method": "Compare encounter CR (the total CR of all opponents) to total character level. The ratio determines difficulty. No multiple-monster XP multiplier is used; action economy is handled by summing CRs, doubling elite CRs, and bumping fractional CRs for low-level parties.",
      "ratios": [
        {
          "difficulty": "easy",
          "encounterCrVsTotalLevel": "1/6",
          "summary": "A fight which isn't in doubt that drains little or no resources."
        },
        {
          "difficulty": "medium",
          "encounterCrVsTotalLevel": "1/3",
          "summary": "A fight which isn't in doubt but may cost a few spells or healing resources."
        },
        {
          "difficulty": "hard",
          "encounterCrVsTotalLevel": "1/2",
          "summary": "The adventurers must spend significant resources to triumph. Losing is possible but the odds are on the party's side."
        },
        {
          "difficulty": "deadly",
          "encounterCrVsTotalLevel": "2/3",
          "summary": "Winning and losing are both possible. The party must spend its best resources."
        },
        {
          "difficulty": "impossible",
          "encounterCrVsTotalLevel": "1 or more",
          "summary": "Almost certain to result in the adventurers losing."
        }
      ],
      "allies": "If the adventurers have monster or NPC allies, add their CR times 3 to the total character level.",
      "elites": "When calculating encounter CR, double the CR of elite monsters. When checking maximum monster CR, use the elite monster's actual CR.",
